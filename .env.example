# Server port
PORT=3002

# PostgreSQL connection string (target database)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/nestar

# Source MongoDB (used only by scripts/migrate.mjs)
MONGO_DEV=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/Nestar
MONGO_PROD=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/NestarProd

# JWT signing secret
SECRET_TOKEN=change-me

# Comma separated list of allowed CORS origins (frontend URL)
ALLOWED_ORIGINS=http://localhost:3000,https://nestar-web.vercel.app
